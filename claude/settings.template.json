{
  "permissions": {
    "allow": []
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "test -f ${CLAUDE_PROJECT_DIR}/.claude/SESSION.md && cat ${CLAUDE_PROJECT_DIR}/.claude/SESSION.md || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "prompt",
            "prompt": "Before ending, invoke the session-save skill to write .claude/SESSION.md capturing current work context (what's in-flight, decisions made, what's next). Skip if nothing meaningful happened this session."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "if": "Bash(gh pr create:*)",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/pr-guardrail/pr-guardrail.sh",
            "timeout": 15,
            "statusMessage": "Checking for existing PRs..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash(git commit:*)",
        "hooks": [
          {
            "type": "prompt",
            "prompt": "A commit was just made. Review the committed changes. If they introduced new patterns, commands, architecture changes, or gotchas that should be documented in CLAUDE.md, update it now. Otherwise do nothing."
          }
        ]
      }
    ]
  }
}
