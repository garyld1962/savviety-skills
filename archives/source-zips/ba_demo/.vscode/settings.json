{
  "chat.agent.maxAutonomousOperations": 100,
  "github.copilot.chat.runCommand.autoApprove": [
    // --- Package managers & runtimes ---
    "pnpm *",
    "npm *",
    "npx *",
    "node *",
    "wsl *",
    // --- Azure CLI (all subcommands) ---
    "az *",

    // --- GitHub CLI (pr, issue, release, etc.) ---
    "gh *",

    // --- Git ---
    "git *",

    // --- Build & test tools ---
    "vitest *",
    "eslint *",
    "prettier *",
    "tsc *",
    "drizzle-kit *",
    "cargo *",
    "turbo *",
    "tsx *",
    "next *",

    // --- Script sourcing ---
    ". *",

    // --- Read commands (PowerShell + Unix) ---
    "cat *",
    "type *",
    "head *",
    "tail *",
    "grep *",
    "Get-Content *",
    "Get-ChildItem *",
    "Get-Location *",
    "Set-Location *",
    "Push-Location *",
    "Pop-Location *",
    "Test-Path *",
    "Select-String *",
    "Select-Object *",
    "Where-Object *",
    "Format-Table *",
    "Format-List *",
    "Out-String *",
    "ls *",
    "dir *",
    "cd *",
    "pwd",

    // --- Write commands (PowerShell + Unix) ---
    "mkdir *",
    "New-Item *",
    "Copy-Item *",
    "Move-Item *",
    "Remove-Item *",
    "Rename-Item *",
    "Write-Output *",
    "echo *",
    "touch *"
  ],
  "chat.tools.autoApprove": {
    "read_file": true,
    "replace_string_in_file": true,
    "multi_replace_string_in_file": true,
    "create_file": true,
    "list_dir": true,
    "file_search": true,
    "grep_search": true,
    "semantic_search": true,
    "search_subagent": true,
    "runSubagent": true,
    "run_in_terminal": true,
    "get_terminal_output": true,
    "get_errors": true,
    "manage_todo_list": true,
    "memory": true,
    "tool_search_tool_regex": true,
    "mcp_excel_excel_describe_sheets": true,
    "mcp_excel_excel_read_sheet": true,
    "mcp_excel_excel_write_to_sheet": true,
    "mcp_excel_excel_create_table": true,
    "mcp_excel_excel_format_range": true,
    "mcp_excel_excel_copy_sheet": true,
    "mcp_excel_excel_screen_capture": true,
    "mcp_word-document_list_available_documents": true,
    "mcp_word-document_get_document_info": true,
    "mcp_word-document_get_document_text": true,
    "mcp_word-document_get_document_outline": true,
    "mcp_word-document_get_document_xml": true,
    "mcp_word-document_find_text_in_document": true,
    "mcp_word-document_create_document": true,
    "mcp_word-document_add_heading": true,
    "mcp_word-document_add_paragraph": true,
    "mcp_word-document_add_table": true,
    "mcp_word-document_add_page_break": true,
    "mcp_word-document_add_picture": true,
    "mcp_word-document_search_and_replace": true,
    "mcp_word-document_format_text": true,
    "mcp_word-document_delete_paragraph": true,
    "mcp_word-document_get_paragraph_text_from_document": true,
    "mcp_word-document_convert_to_pdf": true,
    "mcp_word-document_copy_document": true,
    "mcp_word-document_get_all_comments": true,
    "mcp_word-document_format_table_cell_text": true,
    "mcp_word-document_insert_line_or_paragraph_near_text": true
  },
  "chat.tools.terminal.autoApprove": {
    "Remove-Item *": true,
    "Get-ChildItem *": true,
    "Get-Content *": true,
    "Set-Content *": true,
    "Test-Path *": true,
    "Copy-Item *": true,
    "Move-Item *": true,
    "New-Item *": true,
    "Select-String *": true,
    "uvx *": true,
    "uv *": true,
    "wsl *": true,
    "node *": true,
    "npm *": true,
    "pnpm *": true,
    "git *": true,
    "winget *": true,
    "python *": true,
    "pip *": true,
    "& .\\*": true,
    "where.exe": true
  },
  "chat.promptFilesLocations": {
    ".github/prompts/**/*.prompt.md": true
  }
}
