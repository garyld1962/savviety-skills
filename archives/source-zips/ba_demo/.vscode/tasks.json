{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install",
      "type": "shell",
      "command": "wsl",
      "args": ["-d", "Ubuntu-24.04", "-e", "bash", ".scripts/run.sh", "install"],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Build All",
      "type": "shell",
      "command": "wsl",
      "args": ["-d", "Ubuntu-24.04", "-e", "bash", ".scripts/run.sh", "build"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "Test All",
      "type": "shell",
      "command": "wsl",
      "args": ["-d", "Ubuntu-24.04", "-e", "bash", ".scripts/run.sh", "test"],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Lint All",
      "type": "shell",
      "command": "wsl",
      "args": ["-d", "Ubuntu-24.04", "-e", "bash", ".scripts/run.sh", "lint"],
      "group": "build",
      "problemMatcher": ["$eslint-stylish"]
    },
    {
      "label": "Full CI Pipeline",
      "type": "shell",
      "command": "wsl",
      "args": ["-d", "Ubuntu-24.04", "-e", "bash", ".scripts/run.sh", "all"],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Dev Servers",
      "type": "shell",
      "command": "wsl",
      "args": ["-d", "Ubuntu-24.04", "-e", "bash", ".scripts/run.sh", "dev"],
      "group": "build",
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
