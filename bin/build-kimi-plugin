#!/usr/bin/env python3
"""Build the native Kimi plugin tree from the Claude skill source.

Reads claude/<skill>/SKILL.md, rewrites frontmatter for Kimi Code CLI,
and writes kimi/skills/<skill>/SKILL.md. Supporting files inside the skill
directory are copied verbatim so relative references keep working.

Usage:
    bin/build-kimi-plugin [--check]

--check exits non-zero if the generated tree is out of sync with claude/.
"""

from __future__ import annotations

import argparse
import os
import re
import shutil
import sys
from pathlib import Path

import yaml

REPO_ROOT = Path(__file__).resolve().parents[1]
SOURCE_DIR = REPO_ROOT / "claude"
TARGET_DIR = REPO_ROOT / "kimi" / "skills"

# Non-skill top-level entries that should never be copied as skills.
SKIP_DIRS = {
    "README.md",
    "MODEL-POLICY.md",
    "SESSION-CONTEXT.md",
    "settings.template.json",
    "infra",
    "install-scan",
}

# Skills that are manual, multi-phase pipelines and benefit from type: flow.
FLOW_SKILLS = {
    "kickoff",
    "execute-plan",
    "execute-prd",
    "triage",
    "hotfix",
    "test-plan",
    "checkpoint",
    "pr",
    "ship",
}

# Skills that accept well-defined arguments in Kimi.
ARGUMENTS: dict[str, list[str]] = {
    "domain-review": ["profile"],
    "validate-plan": ["planPath"],
    "execute-plan": ["planPath"],
    "execute-prd": ["source"],
    "work-item": ["workItemId"],
    "drawio": ["diagramType"],
    "test-plan": ["task"],
    "code-investigate": ["query"],
    "prd-validate": ["source"],
    "bug-session": ["context"],
}

# Skills that should never be auto-invoked by the model.
DISABLE_AUTO_INVOCATION = {
    "skill-help",
    "skill-audit",
    "configure",
}


def extract_frontmatter(text: str) -> tuple[dict, str]:
    """Return (frontmatter_dict, body) from a SKILL.md string."""
    if not text.startswith("---"):
        return {}, text
    parts = text.split("---", 2)
    if len(parts) < 3:
        return {}, text
    try:
        fm = yaml.safe_load(parts[1]) or {}
    except yaml.YAMLError as e:
        raise ValueError(f"invalid frontmatter: {e}") from e
    body = parts[2]
    return fm, body


def build_frontmatter(name: str, fm: dict) -> dict:
    """Translate Claude frontmatter to Kimi-native frontmatter."""
    description = fm.get("description") or ""
    if isinstance(description, str):
        description = " ".join(description.split())

    new_fm: dict = {
        "name": name,
        "description": description,
    }

    # Kimi's whenToUse mirrors the description trigger phrases; if the description
    # already contains trigger guidance, reuse it. Otherwise leave it empty.
    if description:
        new_fm["whenToUse"] = description

    if name in FLOW_SKILLS:
        new_fm["type"] = "flow"
        new_fm["disableModelInvocation"] = False

    if name in ARGUMENTS:
        new_fm["arguments"] = ARGUMENTS[name]

    if name in DISABLE_AUTO_INVOCATION:
        new_fm["disableModelInvocation"] = True

    # Preserve any extra metadata that is already Kimi-compatible.
    for key in ("license", "compatibility", "metadata"):
        if key in fm:
            new_fm[key] = fm[key]

    return new_fm


def render_frontmatter(fm: dict) -> str:
    """Render frontmatter as YAML between --- markers."""
    # Use safe_dump and strip the trailing newline so we control spacing.
    yaml_text = yaml.safe_dump(fm, sort_keys=False, allow_unicode=True)
    return f"---\n{yaml_text}---\n"


def rewrite_body_for_kimi(name: str, body: str, known_skills: set[str]) -> str:
    """Make light, safe neutralizations so the body reads well in Kimi."""
    # Replace explicit Claude slash references with Kimi skill invocations, but
    # only for names we actually have in the skill set. This avoids corrupting
    # URLs like https://github.com/... or paths like /tmp/....
    if known_skills:
        pattern = r"(?<![a-zA-Z0-9_./-])/(" + "|".join(re.escape(s) for s in known_skills) + r")(?![a-zA-Z0-9_/-])"
        body = re.sub(pattern, r"/skill:\1", body)

    # Neutralize the most common inline tool-name references that tell the user
    # to "use the X tool" — these are instructions to the user, not model tool
    # calls, and the runtime names differ between CLIs.
    body = re.sub(r"\bRead\s+the\s+file\b", "Read the file", body, flags=re.IGNORECASE)

    # Kimi uses AGENTS.md (with CLAUDE.md fallback) per shared/platforms/kimi.rubric.yaml.
    body = body.replace(
        "Repo missing required CLAUDE.md ## Commands section.",
        "Repo missing required ## Commands section in AGENTS.md (or CLAUDE.md).",
    )
    body = body.replace(
        "Read `CLAUDE.md ## Commands` per",
        "Read `AGENTS.md` (or `CLAUDE.md`) `## Commands` per",
    )

    # Kimi uses the native task-graph execution contract rather than Claude's Workflow tool.
    if name == "execute-plan":
        body = re.sub(
            r"## Launch the runtime\n\nInvoke the Workflow tool:.*?(?=\n## Interpreting the result)",
            "## Launch the runtime\n\n"
            "Execute the validated plan using Kimi's native tools and the shared "
            "[native execution contract](../validate-plan/references/execution.md), "
            "[plan format](../validate-plan/references/plan-format.md), and "
            "[reporting contract](../validate-plan/references/reporting.md). "
            "Validate the plan with `../validate-plan/scripts/validate_plan.py` and "
            "validate `execution-report.json` with `../validate-plan/scripts/validate_report.py`.\n",
            body,
            flags=re.S,
        )
    elif name == "execute-prd":
        body = re.sub(
            r"When it\n   fires, invoke the Workflow tool with.*?(?=\n7\. \*\*Draft the plan\*\*)",
            "When it\n   fires, compare at least two radically different designs "
            "(minimal surface, flexibility, and common-case ergonomics) using "
            "`/skill:design-twice` or parallel Kimi `Agent` exploration, and record "
            "the chosen design and rejected options as a Closed Decision in the plan.\n",
            body,
            flags=re.S,
        )

    # Keep the body largely intact; skill-specific rewrite rules can be added here.
    return body


def copy_supporting_files(src_skill: Path, dst_skill: Path) -> bool:
    """Copy non-SKILL.md files inside a skill dir, preserving structure (except Claude-only .mjs workflows). Returns True if any file changed."""
    changed = False
    expected_names = set()
    for item in src_skill.iterdir():
        if item.name in ("SKILL.md", "workflows"):
            continue
        expected_names.add(item.name)
        dst = dst_skill / item.name
        if item.is_dir():
            if not dst.exists():
                shutil.copytree(item, dst)
                changed = True
            else:
                for src_f in sorted(item.rglob("*")):
                    if not src_f.is_file():
                        continue
                    rel = src_f.relative_to(item)
                    dst_f = dst / rel
                    if not dst_f.exists() or dst_f.read_bytes() != src_f.read_bytes():
                        changed = True
                        dst_f.parent.mkdir(parents=True, exist_ok=True)
                        shutil.copy2(src_f, dst_f)
                for dst_f in sorted(dst.rglob("*")):
                    if dst_f.is_file() and not (item / dst_f.relative_to(dst)).exists():
                        changed = True
                        dst_f.unlink()
        else:
            if not dst.exists() or dst.read_bytes() != item.read_bytes():
                changed = True
                shutil.copy2(item, dst)

    for existing in list(dst_skill.iterdir()):
        if existing.name != "SKILL.md" and existing.name not in expected_names:
            changed = True
            if existing.is_dir():
                shutil.rmtree(existing)
            else:
                existing.unlink()
    return changed


def build_skill(src_skill: Path, dst_skill: Path, name: str, known_skills: set[str]) -> bool:
    """Build one Kimi skill from a Claude skill dir. Returns True if changed."""
    src_file = src_skill / "SKILL.md"
    dst_file = dst_skill / "SKILL.md"

    text = src_file.read_text(encoding="utf-8")
    fm, body = extract_frontmatter(text)

    new_fm = build_frontmatter(name, fm)
    new_body = rewrite_body_for_kimi(name, body, known_skills)

    new_text = render_frontmatter(new_fm) + new_body

    changed = not dst_file.exists() or dst_file.read_text(encoding="utf-8") != new_text

    dst_skill.mkdir(parents=True, exist_ok=True)
    dst_file.write_text(new_text, encoding="utf-8")

    if copy_supporting_files(src_skill, dst_skill):
        changed = True

    return changed


def main() -> int:
    parser = argparse.ArgumentParser(description="Build Kimi plugin skills from Claude source")
    parser.add_argument("--check", action="store_true", help="exit non-zero if out of sync")
    args = parser.parse_args()

    if not SOURCE_DIR.is_dir():
        print(f"error: source dir not found: {SOURCE_DIR}", file=sys.stderr)
        return 1

    # Discover skill names first so body rewriting only targets real skills.
    known_skills: set[str] = set()
    for entry in sorted(SOURCE_DIR.iterdir()):
        if not entry.is_dir():
            continue
        if entry.name in SKIP_DIRS:
            continue
        if (entry / "SKILL.md").is_file():
            known_skills.add(entry.name)

    any_changed = False
    seen: set[str] = set()

    for entry in sorted(SOURCE_DIR.iterdir()):
        if not entry.is_dir():
            continue
        if entry.name in SKIP_DIRS:
            continue
        name = entry.name
        if name == "_internal":
            seen.add(name)
            dst = TARGET_DIR / name
            # Sync _internal rubrics and closed-decisions into kimi/skills/_internal
            if not dst.exists():
                shutil.copytree(entry, dst)
                any_changed = True
                print("built kimi/skills/_internal")
            else:
                # Check if any file inside _internal differs
                internal_changed = False
                for src_file in sorted(entry.rglob("*")):
                    if not src_file.is_file():
                        continue
                    rel = src_file.relative_to(entry)
                    dst_file = dst / rel
                    if not dst_file.exists() or dst_file.read_bytes() != src_file.read_bytes():
                        internal_changed = True
                        dst_file.parent.mkdir(parents=True, exist_ok=True)
                        shutil.copy2(src_file, dst_file)
                for dst_file in sorted(dst.rglob("*")):
                    if dst_file.is_file() and not (entry / dst_file.relative_to(dst)).exists():
                        internal_changed = True
                        dst_file.unlink()
                if internal_changed:
                    any_changed = True
                    print("built kimi/skills/_internal")
            continue

        skill_file = entry / "SKILL.md"
        if not skill_file.is_file():
            continue
        seen.add(name)
        dst = TARGET_DIR / name
        changed = build_skill(entry, dst, name, known_skills)
        if changed:
            any_changed = True
            print(f"built kimi/skills/{name}")

    # Remove orphaned generated skills.
    if TARGET_DIR.exists():
        for entry in TARGET_DIR.iterdir():
            if entry.name not in seen:
                shutil.rmtree(entry)
                any_changed = True
                print(f"removed orphaned kimi/skills/{entry.name}")

    if args.check:
        if any_changed:
            print("error: kimi/skills/ is out of sync with claude/", file=sys.stderr)
            return 1
        print("kimi/skills/ is up to date")
        return 0

    if not any_changed:
        print("kimi/skills/ is already up to date")
    return 0


if __name__ == "__main__":
    sys.exit(main())
