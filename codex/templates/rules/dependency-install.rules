# Prompt before dependency installation commands that may change the local toolchain.
prefix_rule(
  pattern = [["npm", "pnpm", "yarn"], "install"],
  decision = "prompt",
  justification = "Dependency installs can change lockfiles and execute package lifecycle scripts.",
  match = [
    "npm install",
    "pnpm install",
    "yarn install",
  ],
)

prefix_rule(
  pattern = ["pip", "install"],
  decision = "prompt",
  justification = "Python package installs can change the active environment.",
  match = [
    "pip install requests",
  ],
)

prefix_rule(
  pattern = [["cargo", "go"], "install"],
  decision = "prompt",
  justification = "Tool installs can place executables on PATH.",
  match = [
    "cargo install ripgrep",
    "go install example.com/tool@latest",
  ],
)
