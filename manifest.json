{
  "$comment": "Source-of-truth manifest for the repo-skills installer. See docs/repo-skills-design.md.",

  "claude": {
    "skills": {
      "from": "claude",
      "to": ".claude/skills",
      "skip": [
        "README.md",
        "MODEL-POLICY.md",
        "SESSION-CONTEXT.md",
        "settings.template.json",
        "infra"
      ],
      "preserve_subdirs": [
        "_project",
        "_local"
      ]
    },
    "extras": [
      { "from": "claude/infra/pr-guardrail",    "to": ".claude/pr-guardrail" },
      { "from": "claude/infra/journal",         "to": ".claude/journal" },
      { "from": "claude/infra/install-scan",    "to": ".claude/install-scan" },
      { "from": "claude/settings.template.json", "to": ".claude/settings.json" }
    ],
    "starters": [
      { "from": "templates/CLAUDE.starter.md",            "to": "CLAUDE.md" },
      { "from": "templates/CLAUDE.local.md",              "to": "CLAUDE.local.md" },
      { "from": "templates/settings.local.starter.json",  "to": ".claude/settings.local.json" }
    ],
    "gitignore": [
      "CLAUDE.local.md",
      ".claude/journal/*.md",
      ".claude/journal/.lock.*",
      ".claude/SESSION.md"
    ]
  },

  "copilot": {
    "trees": [
      { "from": "copilot-native/prompts",      "to": ".github/prompts" },
      { "from": "copilot-native/agents",       "to": ".github/agents" },
      { "from": "copilot-native/skills",       "to": ".github/skills" },
      { "from": "copilot-native/instructions", "to": ".github/instructions" },
      { "from": "copilot-native/templates",    "to": ".github/templates" }
    ],
    "starters": [
      { "from": "templates/copilot-instructions.starter.md",
        "to":   ".github/copilot-instructions.md" }
    ]
  },

  "codex": {
    "trees": [
      { "from": "codex/plugins",         "to": ".codex/plugins" },
      { "from": "codex/agents",          "to": ".codex/agents" },
      { "from": "codex/prompts",         "to": ".codex/prompts" },
      { "from": "codex/templates/rules", "to": ".codex/rules" },
      { "from": "codex/templates/hooks", "to": ".codex/hooks" }
    ],
    "extras": [
      { "from": "codex/templates/config.toml",      "to": ".codex/config.toml" },
      { "from": "codex/templates/hooks.json",       "to": ".codex/hooks.json" },
      { "from": "codex/templates/marketplace.json", "to": ".claude-plugin/marketplace.json" }
    ],
    "starters": [
      { "from": "codex/templates/AGENTS.starter.md", "to": "AGENTS.md" }
    ],
    "gitignore": [
      ".codex/journal/*.jsonl"
    ]
  },

  "user_owned": [
    ".claude/settings.local.json",
    "CLAUDE.md",
    "CLAUDE.local.md",
    ".github/copilot-instructions.md",
    ".github/instructions/personal.instructions.md",
    "AGENTS.md"
  ]
}
