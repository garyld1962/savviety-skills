<mxfile host="app.diagrams.net" type="device">
  <diagram name="execute-prd as compiler" id="execute-prd-compiler">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2100" pageHeight="620" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="/execute-prd is a compiler — the PRD is source code, the plan is the IR, /execute-plan is code-gen + runtime" style="text;html=1;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="14" width="1500" height="30" as="geometry" />
        </mxCell>

        <!-- band labels -->
        <mxCell id="band_fe" value="FRONT-END  —  analysis" style="text;html=1;fontStyle=2;fontSize=12;align=center;fontColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="260" y="70" width="850" height="20" as="geometry" />
        </mxCell>
        <mxCell id="band_mid" value="MIDDLE  —  optimize" style="text;html=1;fontStyle=2;fontSize=12;align=center;fontColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1140" y="70" width="190" height="20" as="geometry" />
        </mxCell>
        <mxCell id="band_be" value="VERIFY + BACK-END  —  synthesis" style="text;html=1;fontStyle=2;fontSize=12;align=center;fontColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1360" y="70" width="630" height="20" as="geometry" />
        </mxCell>

        <!-- phase labels (row above boxes) -->
        <mxCell id="ph1" value="build config / linkage" style="text;html=1;fontSize=11;align=center;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="260" y="160" width="190" height="20" as="geometry" /></mxCell>
        <mxCell id="ph2" value="lex + parse → AST" style="text;html=1;fontSize=11;align=center;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="480" y="160" width="190" height="20" as="geometry" /></mxCell>
        <mxCell id="ph3" value="semantic analysis / type-check" style="text;html=1;fontSize=11;align=center;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="700" y="160" width="190" height="20" as="geometry" /></mxCell>
        <mxCell id="ph4" value="IR generation" style="text;html=1;fontSize=11;align=center;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="920" y="160" width="190" height="20" as="geometry" /></mxCell>
        <mxCell id="ph5" value="optimizer passes" style="text;html=1;fontSize=11;align=center;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1140" y="160" width="190" height="20" as="geometry" /></mxCell>
        <mxCell id="ph6" value="static verification" style="text;html=1;fontSize=11;align=center;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1360" y="160" width="190" height="20" as="geometry" /></mxCell>
        <mxCell id="ph7" value="code-gen + runtime" style="text;html=1;fontSize=11;align=center;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1580" y="160" width="190" height="20" as="geometry" /></mxCell>
        <mxCell id="ph8" value="executable" style="text;html=1;fontSize=11;align=center;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1800" y="160" width="190" height="20" as="geometry" /></mxCell>

        <!-- stage boxes -->
        <mxCell id="s0" value="PRD / RFC / spec&#10;— source code —" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="190" height="110" as="geometry" /></mxCell>
        <mxCell id="s1" value="Load CLAUDE.md&#10;## Commands&#10;(step 1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="260" y="190" width="190" height="110" as="geometry" /></mxCell>
        <mxCell id="s2" value="Load + classify source&#10;(steps 2–2.5)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="480" y="190" width="190" height="110" as="geometry" /></mxCell>
        <mxCell id="s3" value="/audit-existing +&#10;readiness gate&#10;(steps 3–3.5)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="700" y="190" width="190" height="110" as="geometry" /></mxCell>
        <mxCell id="s4" value="Extract non-negotiables&#10;+ draft plan&#10;(steps 4–5)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="920" y="190" width="190" height="110" as="geometry" /></mxCell>
        <mxCell id="s5" value="/parallel-optimization&#10;(step 6)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1140" y="190" width="190" height="110" as="geometry" /></mxCell>
        <mxCell id="s6" value="/validate-plan&#10;(step 7)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1360" y="190" width="190" height="110" as="geometry" /></mxCell>
        <mxCell id="s7" value="/execute-plan&#10;(step 8)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1580" y="190" width="190" height="110" as="geometry" /></mxCell>
        <mxCell id="s8" value="Built application&#10;— working software —" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1800" y="190" width="190" height="110" as="geometry" /></mxCell>

        <!-- pipeline arrows -->
        <mxCell id="a0" style="endArrow=block;html=1;strokeWidth=2;rounded=0;" edge="1" parent="1" source="s0" target="s1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a1" style="endArrow=block;html=1;strokeWidth=2;rounded=0;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a2" style="endArrow=block;html=1;strokeWidth=2;rounded=0;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a3" style="endArrow=block;html=1;strokeWidth=2;rounded=0;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a4" style="endArrow=block;html=1;strokeWidth=2;rounded=0;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a5" style="endArrow=block;html=1;strokeWidth=2;rounded=0;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a6" style="endArrow=block;html=1;strokeWidth=2;rounded=0;" edge="1" parent="1" source="s6" target="s7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a7" style="endArrow=block;html=1;strokeWidth=2;rounded=0;" edge="1" parent="1" source="s7" target="s8"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- analogy notes (below boxes) -->
        <mxCell id="n2" value="PRD tokens → structured intent" style="text;html=1;fontSize=10;align=center;fontColor=#666666;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="470" y="305" width="210" height="30" as="geometry" /></mxCell>
        <mxCell id="n3" value="rejects ill-formed PRD&#10;before code-gen" style="text;html=1;fontSize=10;align=center;fontColor=#666666;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="690" y="305" width="210" height="34" as="geometry" /></mxCell>
        <mxCell id="n4" value="the plan = intermediate&#10;representation (IR)" style="text;html=1;fontSize=10;align=center;fontColor=#666666;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="910" y="305" width="210" height="34" as="geometry" /></mxCell>
        <mxCell id="n5" value="waves / lanes = optimized IR" style="text;html=1;fontSize=10;align=center;fontColor=#666666;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="1130" y="305" width="210" height="30" as="geometry" /></mxCell>
        <mxCell id="n6" value="type-checks the IR; loop ≤ 3" style="text;html=1;fontSize=10;align=center;fontColor=#666666;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="1350" y="305" width="210" height="30" as="geometry" /></mxCell>
        <mxCell id="n7" value="plan executed → software" style="text;html=1;fontSize=10;align=center;fontColor=#666666;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="1570" y="305" width="210" height="30" as="geometry" /></mxCell>

        <!-- reject branch from typecheck -->
        <mxCell id="halt" value="HALT — PRD rejected&#10;(a compile-time type error)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="700" y="420" width="190" height="60" as="geometry" /></mxCell>
        <mxCell id="a_halt" value="not ready" style="endArrow=block;html=1;strokeWidth=2;rounded=0;dashed=1;strokeColor=#b85450;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s3" target="halt"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- footer thesis line -->
        <mxCell id="foot" value="Same pipeline a compiler runs — only the source language is a requirements doc and the target is an application. The phases are identical; the altitude is higher." style="text;html=1;fontSize=12;fontStyle=2;align=left;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="520" width="1700" height="30" as="geometry" />
        </mxCell>

        <!-- legend -->
        <mxCell id="leg" value="orange = sub-skill call (a library/function call)   ·   blue = internal step   ·   green = source / artefact" style="text;html=1;fontSize=11;align=left;fontColor=#666666;" vertex="1" parent="1">
